# =============================================================
# ScholarSwarm AI — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to git.
# =============================================================

# ── LLM Provider (choose ONE and fill it in) ─────────────────
# Option A: OpenAI  → https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option B: Google Gemini  → https://ai.google.dev/
GOOGLE_API_KEY=

# Option C: Anthropic Claude  → https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which provider to use: "openai" | "gemini" | "anthropic"
LLM_PROVIDER=openai

# Model name (leave blank for sensible defaults)
# openai   default: gpt-4o-mini
# gemini   default: gemini-1.5-flash
# anthropic default: claude-3-haiku-20240307
LLM_MODEL=

# ── Web Search API (choose ONE) ───────────────────────────────
# Option A: Tavily (recommended, free tier) → https://app.tavily.com
TAVILY_API_KEY=

# Option B: SerpAPI (alternative) → https://serpapi.com
SERPAPI_API_KEY=

# ── Backend settings ─────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max file size for uploads (bytes), default 10 MB
MAX_UPLOAD_SIZE=10485760

# ── Demo Mode ────────────────────────────────────────────────
# Set to "true" to run without real API keys (clearly labeled demo data)
DEMO_MODE=false
